# Sao chép thành .env trên server rồi điền. KHÔNG commit file .env.

# Cổng: client LAN gọi thẳng nên server văn phòng dùng 0.0.0.0; máy khác để 127.0.0.1.
BIND_ADDR=127.0.0.1
HOST_PORT=3001
# uid/gid của user trên host sở hữu ./downloads và ./data
RUN_UID=1000
RUN_GID=1000

# Downloader (tuỳ chọn)
MAX_ACTIVE_JOBS=3
YTDLP_AUTO_UPDATE=1
YTDLP_COOKIES_FILE=
DOUYIN_BROWSER_FALLBACK=0

# Hey Tools — trang quản trị /tools/admin (thiếu một biến là quản trị bị khoá)
# Team domain của Cloudflare Zero Trust, không có https://
CF_ACCESS_TEAM_DOMAIN=heymedia.cloudflareaccess.com
# "Application Audience (AUD) Tag" của ứng dụng Access "Hey Tools Admin"
CF_ACCESS_AUD=
# Email admin, cách nhau bằng dấu phẩy; phải khớp policy của ứng dụng Access
ADMIN_EMAILS=
